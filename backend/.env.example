# Copy this file to .env (it is ignored by git) and put your real values there.
# The double underscore becomes ":" in .NET configuration: ConnectionStrings:Default.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=losslens;Username=postgres;Password=change-me

# Secret for signing access tokens: at least 32 characters, keep it private.
# Generate one with: openssl rand -base64 48
Jwt__Key=change-me-to-a-long-random-secret-of-32-chars-or-more
# Optional: when set (8+ characters), the demo users manager, supervisor, operator1 and operator2
# are created at start with this password. Leave it empty to create no users.
Auth__DemoPassword=
