# Copy this file to .env (it is ignored by git) and set a real password.
# docker compose reads .env from this folder automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=losslens

# Host ports
DB_PORT=5432
BACKEND_PORT=5141
FRONTEND_PORT=4200

# Backend secrets. JWT_KEY signs the access tokens (32+ characters, keep it private).
# Generate one with: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-of-32-chars-or-more
# Optional: password of the demo users (manager, supervisor, operator1, operator2), 8+ characters.
DEMO_PASSWORD=
